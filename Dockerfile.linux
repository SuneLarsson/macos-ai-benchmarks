# Start from the official PyTorch image for CUDA support
FROM pytorch/pytorch:latest

# Install Git and FIO (for the storage benchmark)
RUN apt-get update && \
    apt-get install -y --no-install-recommends git fio && \
    rm -rf /var/lib/apt/lists/*

# Install HuggingFace layers and MLX with CUDA 12 support
RUN pip install --no-cache-dir mlx[cuda12] transformers accelerate mlx-lm